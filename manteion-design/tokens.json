{
  "$schema": "https://tokens.studio (import as token sets; each top-level key is a set / theme dimension)",
  "_meta": {
    "name": "Manteion Design System",
    "description": "Tokens for the faults-lab operator console. DARK is the default theme (color set 'dark'); 'light' is the legacy codebase theme. Import 'dark' + 'light' as two color token sets and bind them to a Figma variable collection with two modes; import 'size' once (mode-independent).",
    "defaultColorSet": "dark"
  },

  "dark": {
    "color": {
      "background":            { "$type": "color", "$value": "#0a0a0c", "$description": "app canvas — near-black, not pure" },
      "foreground":            { "$type": "color", "$value": "#e3e3e7", "$description": "primary text — soft white, never #fff" },
      "card":                  { "$type": "color", "$value": "#131316" },
      "card-foreground":       { "$type": "color", "$value": "#e3e3e7" },
      "popover":               { "$type": "color", "$value": "#161619" },
      "popover-foreground":    { "$type": "color", "$value": "#e3e3e7" },
      "primary":               { "$type": "color", "$value": "#3b82f6", "$description": "the ONE actionable color — buttons, links, active accent, focus" },
      "primary-foreground":    { "$type": "color", "$value": "#0a0a0c" },
      "primary-muted":         { "$type": "color", "$value": "#1d2740" },
      "secondary":             { "$type": "color", "$value": "#1c1c20" },
      "secondary-foreground":  { "$type": "color", "$value": "#e3e3e7" },
      "muted":                 { "$type": "color", "$value": "#18181b" },
      "muted-foreground":      { "$type": "color", "$value": "#8a8a93" },
      "accent":                { "$type": "color", "$value": "#202024" },
      "accent-foreground":     { "$type": "color", "$value": "#f4f4f5" },
      "destructive":           { "$type": "color", "$value": "#f0473e" },
      "destructive-foreground":{ "$type": "color", "$value": "#0a0a0c" },
      "destructive-muted":     { "$type": "color", "$value": "#3a1715" },
      "border":                { "$type": "color", "$value": "#26262b" },
      "border-strong":         { "$type": "color", "$value": "#34343b" },
      "input":                 { "$type": "color", "$value": "#2a2a30" },
      "ring":                  { "$type": "color", "$value": "#3b82f6" },
      "sidebar":               { "$type": "color", "$value": "#08080a" },
      "sidebar-foreground":    { "$type": "color", "$value": "#e3e3e7" },
      "sidebar-primary":       { "$type": "color", "$value": "#3b82f6" },
      "sidebar-accent":        { "$type": "color", "$value": "#18181c" },
      "sidebar-border":        { "$type": "color", "$value": "#1e1e22" },
      "sidebar-muted":         { "$type": "color", "$value": "#6e6e77" },
      "status-healthy":        { "$type": "color", "$value": "#3fb950", "$description": "alive, ok, within SLO" },
      "status-degraded":       { "$type": "color", "$value": "#d29922", "$description": "stale, warning, near-SLO" },
      "status-down":           { "$type": "color", "$value": "#f85149", "$description": "dead, failing, SLO breach" },
      "status-unknown":        { "$type": "color", "$value": "#6e6e77" },
      "status-healthy-muted":  { "$type": "color", "$value": "#11231a" },
      "status-degraded-muted": { "$type": "color", "$value": "#2a2110" },
      "status-down-muted":     { "$type": "color", "$value": "#2c1513" },
      "phase-baseline":        { "$type": "color", "$value": "#8a8a93" },
      "phase-isolation":       { "$type": "color", "$value": "#3b82f6" },
      "phase-combined":        { "$type": "color", "$value": "#a855f7" },
      "phase-failed":          { "$type": "color", "$value": "#f85149" },
      "phase-pending":         { "$type": "color", "$value": "#2a2a30" },
      "chart-1":               { "$type": "color", "$value": "#3b82f6", "$description": "RPS / throughput" },
      "chart-2":               { "$type": "color", "$value": "#f85149", "$description": "p99 / latency" },
      "chart-3":               { "$type": "color", "$value": "#3fb950", "$description": "success / cache-hit" },
      "chart-4":               { "$type": "color", "$value": "#d29922", "$description": "error rate" },
      "chart-5":               { "$type": "color", "$value": "#a855f7", "$description": "combined / secondary" },
      "chart-6":               { "$type": "color", "$value": "#2dd4bf", "$description": "p50 / aux" },
      "latency-good":          { "$type": "color", "$value": "#3fb950" },
      "latency-warn":          { "$type": "color", "$value": "#d29922" },
      "latency-bad":           { "$type": "color", "$value": "#f85149" },
      "surface-sunken":        { "$type": "color", "$value": "#0d0d10", "$description": "code blocks, wells, table headers" },
      "text-mono":             { "$type": "color", "$value": "#c8c8d0", "$description": "identifiers, latencies — slightly cooler" }
    }
  },

  "light": {
    "color": {
      "background":            { "$type": "color", "$value": "#ffffff" },
      "foreground":            { "$type": "color", "$value": "#0a0a0a" },
      "card":                  { "$type": "color", "$value": "#ffffff" },
      "card-foreground":       { "$type": "color", "$value": "#0a0a0a" },
      "popover":               { "$type": "color", "$value": "#ffffff" },
      "popover-foreground":    { "$type": "color", "$value": "#0a0a0a" },
      "primary":               { "$type": "color", "$value": "#2563eb" },
      "primary-foreground":    { "$type": "color", "$value": "#ffffff" },
      "primary-muted":         { "$type": "color", "$value": "#eff5ff" },
      "secondary":             { "$type": "color", "$value": "#f4f4f5" },
      "secondary-foreground":  { "$type": "color", "$value": "#18181b" },
      "muted":                 { "$type": "color", "$value": "#f4f4f5" },
      "muted-foreground":      { "$type": "color", "$value": "#71717a" },
      "accent":                { "$type": "color", "$value": "#f4f4f5" },
      "accent-foreground":     { "$type": "color", "$value": "#18181b" },
      "destructive":           { "$type": "color", "$value": "#dc2626" },
      "destructive-foreground":{ "$type": "color", "$value": "#ffffff" },
      "destructive-muted":     { "$type": "color", "$value": "#fef2f2" },
      "border":                { "$type": "color", "$value": "#e4e4e7" },
      "border-strong":         { "$type": "color", "$value": "#d4d4d8" },
      "input":                 { "$type": "color", "$value": "#e4e4e7" },
      "ring":                  { "$type": "color", "$value": "#3b82f6" },
      "sidebar":               { "$type": "color", "$value": "#0a0a0a" },
      "sidebar-foreground":    { "$type": "color", "$value": "#fafafa" },
      "sidebar-primary":       { "$type": "color", "$value": "#2563eb" },
      "sidebar-accent":        { "$type": "color", "$value": "#18181b" },
      "sidebar-border":        { "$type": "color", "$value": "#27272a" },
      "sidebar-muted":         { "$type": "color", "$value": "#a1a1aa" },
      "status-healthy":        { "$type": "color", "$value": "#16a34a" },
      "status-degraded":       { "$type": "color", "$value": "#ca8a04" },
      "status-down":           { "$type": "color", "$value": "#dc2626" },
      "status-unknown":        { "$type": "color", "$value": "#a1a1aa" },
      "status-healthy-muted":  { "$type": "color", "$value": "#f0fdf4" },
      "status-degraded-muted": { "$type": "color", "$value": "#fefce8" },
      "status-down-muted":     { "$type": "color", "$value": "#fef2f2" },
      "phase-baseline":        { "$type": "color", "$value": "#71717a" },
      "phase-isolation":       { "$type": "color", "$value": "#2563eb" },
      "phase-combined":        { "$type": "color", "$value": "#a855f7" },
      "phase-failed":          { "$type": "color", "$value": "#dc2626" },
      "phase-pending":         { "$type": "color", "$value": "#e4e4e7" },
      "chart-1":               { "$type": "color", "$value": "#2563eb" },
      "chart-2":               { "$type": "color", "$value": "#dc2626" },
      "chart-3":               { "$type": "color", "$value": "#16a34a" },
      "chart-4":               { "$type": "color", "$value": "#ca8a04" },
      "chart-5":               { "$type": "color", "$value": "#a855f7" },
      "chart-6":               { "$type": "color", "$value": "#0d9488" },
      "latency-good":          { "$type": "color", "$value": "#16a34a" },
      "latency-warn":          { "$type": "color", "$value": "#ca8a04" },
      "latency-bad":           { "$type": "color", "$value": "#dc2626" },
      "surface-sunken":        { "$type": "color", "$value": "#fafafa" },
      "text-mono":             { "$type": "color", "$value": "#3f3f46" }
    }
  },

  "size": {
    "space": {
      "0":  { "$type": "dimension", "$value": "0px" },
      "1":  { "$type": "dimension", "$value": "4px" },
      "2":  { "$type": "dimension", "$value": "8px" },
      "3":  { "$type": "dimension", "$value": "12px" },
      "4":  { "$type": "dimension", "$value": "16px" },
      "5":  { "$type": "dimension", "$value": "20px" },
      "6":  { "$type": "dimension", "$value": "24px", "$description": "card padding, section gap" },
      "8":  { "$type": "dimension", "$value": "32px" },
      "10": { "$type": "dimension", "$value": "40px" },
      "12": { "$type": "dimension", "$value": "48px", "$description": "table / nav row height" }
    },
    "radius": {
      "sm":   { "$type": "dimension", "$value": "4px" },
      "md":   { "$type": "dimension", "$value": "6px", "$description": "inputs, buttons" },
      "lg":   { "$type": "dimension", "$value": "8px", "$description": "cards, panels" },
      "xl":   { "$type": "dimension", "$value": "12px", "$description": "dialogs" },
      "full": { "$type": "dimension", "$value": "9999px" }
    },
    "layout": {
      "sidebar-width": { "$type": "dimension", "$value": "240px" },
      "topbar-height": { "$type": "dimension", "$value": "56px" },
      "row-height":    { "$type": "dimension", "$value": "48px" },
      "content-max":   { "$type": "dimension", "$value": "1440px" }
    },
    "control": {
      "sm": { "$type": "dimension", "$value": "28px" },
      "md": { "$type": "dimension", "$value": "36px" },
      "lg": { "$type": "dimension", "$value": "40px" }
    }
  },

  "font": {
    "family": {
      "sans": { "$type": "fontFamily", "$value": "Inter", "$description": "all UI text" },
      "mono": { "$type": "fontFamily", "$value": "JetBrains Mono", "$description": "every identifier / latency / code token" }
    },
    "size": {
      "xs":   { "$type": "dimension", "$value": "12px" },
      "sm":   { "$type": "dimension", "$value": "14px" },
      "base": { "$type": "dimension", "$value": "16px" },
      "lg":   { "$type": "dimension", "$value": "18px" },
      "xl":   { "$type": "dimension", "$value": "20px" },
      "2xl":  { "$type": "dimension", "$value": "24px" },
      "3xl":  { "$type": "dimension", "$value": "30px" }
    },
    "weight": {
      "regular":   { "$type": "fontWeight", "$value": 400 },
      "medium":    { "$type": "fontWeight", "$value": 500 },
      "semibold":  { "$type": "fontWeight", "$value": 600 },
      "bold":      { "$type": "fontWeight", "$value": 700 },
      "extrabold": { "$type": "fontWeight", "$value": 800 }
    }
  }
}
