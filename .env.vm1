# `pnpm dev --mode vm1`: talk to manteion-go on VM1 through the ssh tunnel
# (docs/ops/connecting-to-vm1.md) instead of the mock fixtures. Mode files
# outrank .env.local, so VITE_USE_MOCK=true there does not leak in.
VITE_USE_MOCK=false
VITE_MANTEION_URL=http://localhost:5174
# Grafana through the same tunnel (VM1 127.0.0.1:19300 -> svc/grafana:3000).
# Links only: VM1's Grafana denies framing (VITE_GRAFANA_EMBED stays unset).
VITE_GRAFANA_URL=http://localhost:3300
